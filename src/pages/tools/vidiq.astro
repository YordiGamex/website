---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import VidiqInsights from "../../components/VidiqInsights";
---

<StarlightPage frontmatter={{ title: "Analizador estilo vidIQ", description: "Explora ideas, etiquetas y métricas de canales y videos." }} hasSidebar={true}>
    <div class="not-content">
        <VidiqInsights client:only="react" />
    </div>
</StarlightPage>

<style>
    :global(body) {
        font-family: var(--__sl-font) !important;
        color: var(--sl-color-text);
        background: radial-gradient(circle at 10% 20%, rgba(124, 58, 237, 0.08), transparent 25%),
            radial-gradient(circle at 80% 0%, rgba(34, 197, 94, 0.08), transparent 20%),
            var(--sl-color-bg);
        min-height: 100vh;
    }

    .not-content {
        padding: 1rem 0 3rem 0;
    }

    .insights-grid {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .hero {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
        align-items: center;
    }

    .glass {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 18px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    }

    .card {
        padding: 1.25rem 1.4rem;
    }

    h1 {
        font-size: clamp(1.8rem, 2vw, 2.4rem);
        margin: 0.15rem 0 0.35rem;
    }

    h2,
    h3,
    h4 {
        margin: 0;
    }

    .eyebrow {
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--sl-color-accent);
        margin: 0;
    }

    .lede {
        color: var(--sl-color-gray-2);
        margin-bottom: 1.25rem;
    }

    .hero-metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.75rem;
    }

    .metric-card {
        padding: 0.9rem 1rem;
        border-radius: 14px;
        border: 1px solid var(--sl-color-gray-5);
        background: rgba(255, 255, 255, 0.02);
        display: grid;
        gap: 0.2rem;
    }

    .metric-card strong {
        font-size: 1.6rem;
        color: var(--sl-color-accent);
    }

    label {
        display: grid;
        gap: 0.35rem;
        margin-bottom: 0.75rem;
        font-weight: 600;
        color: var(--sl-color-gray-1);
    }

    input,
    textarea,
    select,
    .search {
        width: 100%;
        border-radius: 12px;
        border: 1px solid var(--sl-color-gray-5);
        padding: 0.7rem 0.8rem;
        background: rgba(0, 0, 0, 0.1);
        color: var(--sl-color-text);
    }

    textarea {
        resize: vertical;
    }

    select {
        cursor: pointer;
    }

    .tag-pills,
    .trending-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .pill {
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        border: 1px solid transparent;
        color: var(--sl-color-text);
        background: rgba(255, 255, 255, 0.06);
        font-weight: 600;
        font-size: 0.9rem;
    }

    .pill.solid {
        color: #0b0b0d;
    }

    .hint {
        color: var(--sl-color-gray-2);
        margin: 0.2rem 0 0;
    }

    .grid.two {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.5rem;
    }

    .badge {
        background: var(--sl-color-accent);
        color: #0b0b0d;
        border-radius: 999px;
        padding: 0.35rem 0.8rem;
        font-weight: 700;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .badge.ghost {
        background: rgba(255, 255, 255, 0.06);
        color: var(--sl-color-text);
        border: 1px solid var(--sl-color-gray-5);
    }

    .summary {
        color: var(--sl-color-gray-2);
        margin: 0.25rem 0 0.75rem;
    }

    .progress-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        margin: 0.75rem 0;
    }

    .progress {
        background: rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        height: 8px;
        overflow: hidden;
        border: 1px solid var(--sl-color-gray-5);
    }

    .progress span {
        display: block;
        height: 100%;
        background: var(--sl-color-accent);
    }

    .progress.accent span {
        background: linear-gradient(90deg, #f59e0b, #f43f5e);
    }

    .progress.green span {
        background: linear-gradient(90deg, #22c55e, #2dd4bf);
    }

    .keyword-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 0.75rem;
        margin-top: 0.5rem;
    }

    .keyword-card {
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 12px;
        padding: 0.8rem;
        background: rgba(255, 255, 255, 0.02);
        display: grid;
        gap: 0.2rem;
    }

    .idea-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.65rem;
    }

    .idea-list li {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.65rem 0.2rem;
        border-bottom: 1px solid var(--sl-color-gray-5);
    }

    .idea-title {
        font-weight: 700;
        margin: 0;
    }

    .idea-reason {
        margin: 0.15rem 0 0;
        color: var(--sl-color-gray-2);
    }

    .idea-views {
        color: var(--sl-color-accent);
        font-weight: 800;
        white-space: nowrap;
    }

    .search {
        max-width: 320px;
        background: rgba(255, 255, 255, 0.04);
    }

    .channel-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 0.75rem;
        margin: 1rem 0;
    }

    .channel-card {
        text-align: left;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 16px;
        padding: 0.9rem;
        color: inherit;
        cursor: pointer;
        transition: border 150ms ease, transform 150ms ease;
    }

    .channel-card:hover {
        border-color: var(--sl-color-accent);
        transform: translateY(-2px);
    }

    .channel-card.active {
        border-color: var(--sl-color-accent-high);
        background: rgba(124, 58, 237, 0.04);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .channel-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .channel-name {
        margin: 0;
        font-weight: 800;
    }

    .channel-meta {
        margin: 0.2rem 0 0;
        color: var(--sl-color-gray-2);
    }

    .channel-metrics {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.35rem;
        margin: 0.75rem 0;
    }

    .channel-metrics p {
        margin: 0;
        color: var(--sl-color-gray-2);
    }

    .best-videos {
        border-top: 1px dashed var(--sl-color-gray-5);
        padding-top: 0.75rem;
    }

    .video-table {
        display: grid;
        gap: 0.65rem;
    }

    .video-row {
        padding: 0.75rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.02);
        display: grid;
        gap: 0.35rem;
    }

    .video-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 0.75rem;
    }

    .winning-card {
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 12px;
        padding: 0.75rem;
        background: rgba(255, 255, 255, 0.02);
        display: grid;
        gap: 0.3rem;
    }

    @media (max-width: 720px) {
        .section-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .channel-metrics {
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        }
    }
</style>
